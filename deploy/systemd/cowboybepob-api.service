[Unit]
Description=CowboyBepob API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cowboybepob
Group=cowboybepob
WorkingDirectory=/home/abdulrahman/projects/cowboybepob
EnvironmentFile=/home/abdulrahman/projects/cowboybepob/.env
ExecStart=/usr/bin/npm run start:api
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
