[Unit]
Description=CowboyBepob worker
After=network-online.target postgresql.service cowboybepob-api.service
Wants=network-online.target

[Service]
Type=simple
User=abdulrahman
Group=abdulrahman
WorkingDirectory=/home/abdulrahman/projects/cowboybepob
Environment=HOME=/home/abdulrahman
Environment=NODE_ENV=production
EnvironmentFile=/home/abdulrahman/projects/cowboybepob/.env
ExecStart=/usr/bin/npm run start:worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
