NODE_ENV=production
# Public entrypoint: Nginx listens on 5001.
# API is private on 127.0.0.1:5002.
PORT=5002
DATABASE_URL=postgres://cowboybepob:replace-password@127.0.0.1:5432/cowboybepob
CORS_ORIGIN=http://YOUR_SERVER_IP:5001
COOKIE_SECURE=false
SESSION_DAYS=7
ENCRYPTION_KEY=replace-with-32-byte-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
# Base32 TOTP secret for the initial SUPER_ADMIN account.
ADMIN_TOTP_SECRET=replace-with-base32-secret
MARZBAN_BASE_URL=http://127.0.0.1:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=replace-with-marzban-password
# Same-origin production build. Nginx proxies /api to 127.0.0.1:5002.
VITE_API_URL=/
