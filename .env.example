NODE_ENV=production
PORT=5002
DATABASE_URL=postgres://cowboybepob:replace-password@127.0.0.1:5432/cowboybepob
# Public website origin used for CORS and verification links.
CORS_ORIGIN=https://cowboybebop.site
PUBLIC_APP_URL=https://cowboybebop.site
COOKIE_SECURE=true
SESSION_DAYS=7
ENCRYPTION_KEY=replace-with-32-byte-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_TOTP_SECRET=replace-with-base32-secret

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_EMAIL=no-reply@cowboybebop.site
MAIL_FROM_NAME=CowboyBepob

# Marzban credentials are stored encrypted in provider_instances.
# Do not put MARZBAN_USERNAME or MARZBAN_PASSWORD here.
VITE_API_URL=/

# Optional payment webhook secrets
# WEBHOOK_SECRET_PAYMOB=replace-me
# WEBHOOK_SECRET_OTHER=replace-me

# Optional lifecycle settings
GRACE_PERIOD_DAYS=3
RETENTION_DAYS=30

# ─── Payments ────────────────────────────────────────────────────────────────
# Orders below this (EGP) can only use Vodafone Cash. Card / Apple Pay need >= this.
PAYMENT_GATEWAY_MIN_AMOUNT=75
# How long an AUTO_VERIFIED Vodafone Cash payment waits for the accountant (service runs meanwhile).
ACCOUNTANT_REVIEW_HOURS=24
# Customer must transfer within this many minutes of choosing Vodafone Cash.
PAYMENT_WINDOW_MINUTES=30
# Tolerance between phone clock / SMS time and the payment window.
PAYMENT_SMS_CLOCK_SKEW_MINUTES=10
# Activate services during the review window (true = business rule). Routers never ship before PAID.
PAYMENT_PROVISIONAL_ACTIVATION=true
# Our receiving Vodafone Cash wallet(s), comma-separated. The first is shown to customers.
VODAFONE_CASH_RECEIVING_WALLET=010XXXXXXXX
# Private folder for receipt screenshots (NOT inside apps/web/public). Must be writable by the API user.
PAYMENT_UPLOAD_DIR=/home/abdulrahman/projects/cowboybepob/storage/payment-screenshots
PAYMENT_SCREENSHOT_MAX_BYTES=4194304
# Optional bootstrap token for the first Android device (min 24 chars). Prefer creating devices in the admin panel.
ANDROID_PAYMENT_DEVICE_TOKEN=
# Public API base used in Kashier's serverWebhook (defaults to PUBLIC_APP_URL; nginx proxies /api).
PUBLIC_API_URL=https://cowboybebop.site

# Kashier (cards + Apple Pay). From merchant.kashier.io → Developers → API keys.
KASHIER_MERCHANT_ID=MID-XXX-XXX
# The "Payment API Key" (signs the order hash AND verifies webhooks). Test and live keys differ.
KASHIER_API_KEY=
KASHIER_MODE=test
KASHIER_CHECKOUT_URL=https://checkout.kashier.io
# How Kashier sends data.amount in webhooks. Verify in test mode, then keep.
KASHIER_WEBHOOK_AMOUNT_UNIT=major
KASHIER_CHECKOUT_TTL_MINUTES=60
